{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "platform-microservice values",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "namespace": { "type": "string" },
    "commonLabels": { "type": "object" },
    "commonAnnotations": { "type": "object" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "strategy": { "type": "object" },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": ["string", "number"] },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": ["array", "string"] },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "command": { "type": "array" },
    "args": { "type": "array" },
    "rollOnConfigChange": { "type": "boolean" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "priorityClassName": { "type": "string" },
    "lifecycle": { "type": "object" },
    "initContainers": { "type": "array" },
    "extraContainers": { "type": "array" },
    "service": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "name": { "type": "string" },
        "protocol": { "type": "string" },
        "annotations": { "type": "object" },
        "extraPorts": { "type": "array" }
      }
    },
    "extraContainerPorts": { "type": "array" },
    "httproute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "labels": { "type": "object" },
        "annotations": { "type": "object" },
        "gateway": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "namespace": { "type": "string" },
            "sectionName": { "type": "string" }
          }
        },
        "hostnames": { "type": "array", "items": { "type": "string" } },
        "cors": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
        "rules": { "type": "array" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "resources": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "startupProbe": { "type": "object" },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": ["integer", "null"] },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"] },
        "metrics": { "type": "array" },
        "behavior": { "type": "object" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "config": { "type": "object" },
    "secrets": { "type": "object" },
    "existingConfigMaps": { "type": "array", "items": { "type": "string" } },
    "existingSecrets": { "type": "array", "items": { "type": "string" } },
    "env": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "secretFiles": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mountPath": { "type": "string" },
        "existingSecret": { "type": "string" },
        "files": { "type": "object" }
      }
    },
    "configMount": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mountPath": { "type": "string" }
      }
    },
    "volumes": { "type": "array" },
    "volumeMounts": { "type": "array" },
    "logging": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "insecure": { "type": "boolean" },
        "logPath": { "type": "string" },
        "format": { "type": "string", "enum": ["json", "text"] },
        "environment": { "type": "string" },
        "otelCollector": { "type": "object" },
        "loki": { "type": "object" },
        "tempo": { "type": "object" },
        "prometheus": { "type": "object" },
        "metrics": { "type": "object" },
        "extraLabels": { "type": "object" }
      }
    }
  }
}
